{
  // Cloudflare Worker in front of the Python app, which runs in a Cloudflare Container.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "podcast-movie-extractor",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  // static/index.html is bundled into the Worker as a text module.
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "containers": [
    {
      "name": "podcast-movie-extractor-app",
      "class_name": "App",
      "scheduling_policy": "durable_object",
      "images": { "base": { "dockerfile": "./Dockerfile" } }
    }
  ],
  "durable_objects": { "bindings": [{ "name": "APP", "class_name": "App" }] },
  "exports": {
    "App": { "type": "durable-object", "storage": "sqlite", "container": "podcast-movie-extractor-app" }
  }
}
